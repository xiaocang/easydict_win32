<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Win2D backend. Every Win2D and WinUI API call in the direct renderer lives in this
    project, so if Win2D turns out not to support Windows App SDK 2.x the replacement is scoped
    to here — the display list it consumes is backend-neutral by construction.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Easydict.DirectXaml.Win2D</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.*" />
    <!--
      Floating until the compatibility check in ci.yml reports what actually resolves against
      WindowsAppSDK 2.0.*. Pin this to the exact resolved version once that is known — the repo
      already does the same for Microsoft.Windows.AI.MachineLearning.
    -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Easydict.DirectXaml\Easydict.DirectXaml.csproj" />
    <ProjectReference Include="..\Polyglot.TextLayout\Polyglot.TextLayout.csproj" />
  </ItemGroup>

</Project>
