<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Easydict.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Easydict.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Easydict Color Theme -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent and Status Colors are now theme-aware via Themes/Colors.xaml -->

            <!-- Shared Fluent surfaces preserve existing page style contracts. -->
            <Style x:Key="EasydictSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource EasydictCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource EasydictCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource EasydictCardBorderThickness}" />
                <Setter Property="CornerRadius" Value="{ThemeResource EasydictCardCornerRadius}" />
                <Setter Property="Padding" Value="{ThemeResource EasydictCardPadding}" />
            </Style>

            <Style x:Key="EasydictElevatedSurfaceStyle" TargetType="Border" BasedOn="{StaticResource EasydictSurfaceStyle}">
                <Setter Property="Background" Value="{ThemeResource EasydictLayerFillBrush}" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource EasydictElevatedSurfaceStyle}" />

            <Style x:Key="EasydictInputPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource EasydictInputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource EasydictInputBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource EasydictCardBorderThickness}" />
                <Setter Property="CornerRadius" Value="{ThemeResource EasydictControlCornerRadius}" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="EasydictBaseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="CornerRadius" Value="{ThemeResource EasydictControlCornerRadius}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="EasydictChipButtonStyle" TargetType="Button" BasedOn="{StaticResource EasydictBaseButtonStyle}">
                <Setter Property="Padding" Value="12,7" />
            </Style>

            <Style x:Key="EasydictIconButtonStyle" TargetType="Button" BasedOn="{StaticResource EasydictBaseButtonStyle}">
                <Setter Property="Width" Value="{ThemeResource EasydictCompactControlSize}" />
                <Setter Property="Height" Value="{ThemeResource EasydictCompactControlSize}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="EasydictAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="{ThemeResource EasydictControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource EasydictAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource EasydictAccentForegroundBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="EasydictPrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource EasydictAccentButtonStyle}">
                <Setter Property="Width" Value="{ThemeResource EasydictStandardControlHeight}" />
                <Setter Property="Height" Value="{ThemeResource EasydictStandardControlHeight}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="TranslationTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="{ThemeResource EasydictControlCornerRadius}" />
                <Setter Property="MinHeight" Value="{ThemeResource EasydictStandardControlHeight}" />
            </Style>

            <Style x:Key="CompactTranslationTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TranslationTextBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="MaxHeight" Value="120" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
