<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easydict.WinUI.Views">
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="SavedItemsSelectedFill" Color="{ThemeResource AccentColor}" Opacity="0.13"/>
                <SolidColorBrush x:Key="SavedItemsSelectionMarker" Color="{ThemeResource AccentColor}"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="SavedItemsSelectedFill" Color="{ThemeResource SystemColorWindowColor}"/>
                <SolidColorBrush x:Key="SavedItemsSelectionMarker" Color="{ThemeResource SystemColorHighlightColor}"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <SolidColorBrush x:Key="ExpanderForeground" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderForegroundPointerOver" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderForegroundPressed" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderChevronForeground" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderChevronPointerOverForeground" Color="{ThemeResource QueryTextColor}"/>
        <SolidColorBrush x:Key="ExpanderChevronPressedForeground" Color="{ThemeResource QueryTextColor}"/>
        <Style x:Key="SavedItemSurfaceStyle" TargetType="local:SavedItemCard">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SavedItemCard">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="SurfaceStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateSurface.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="StateSurface.Background" Value="{ThemeResource SavedItemsSelectedFill}"/>
                                            <Setter Target="StateSurface.BorderBrush" Value="{ThemeResource SavedItemsSelectionMarker}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"/>
                            <Border x:Name="StateSurface" Background="Transparent" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SavedItemsRailButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EasydictIconButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style x:Key="SavedItemsIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EasydictIconButtonStyle}"/>
        <Style x:Key="SavedItemsSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EasydictBaseButtonStyle}"/>
        <Style x:Key="SavedItemsPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EasydictAccentButtonStyle}"/>
        <Style x:Key="SavedItemsCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource EasydictSurfaceStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="SavedItemsDetailCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource EasydictElevatedSurfaceStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="SavedItemsTagPillStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SavedItemsTagButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EasydictBaseButtonStyle}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="SavedItemsCardContainerStyle" TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>

</ResourceDictionary>
