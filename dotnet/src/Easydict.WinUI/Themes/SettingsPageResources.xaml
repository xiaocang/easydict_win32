<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SettingsLinkForegroundBrush"
                     Color="{ThemeResource EasydictControlLinkColor}" />
    <!-- Per-page WinUI lightweight styling overrides keep control templates on the app theme. -->
    <SolidColorBrush x:Key="ToggleSwitchHeaderForeground"
                     Color="{ThemeResource EasydictControlPrimaryTextColor}" />
    <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled"
                     Color="{ThemeResource EasydictControlTertiaryTextColor}" />
    <SolidColorBrush x:Key="TextControlHeaderForeground"
                     Color="{ThemeResource EasydictControlPrimaryTextColor}" />
    <SolidColorBrush x:Key="TextControlHeaderForegroundDisabled"
                     Color="{ThemeResource EasydictControlTertiaryTextColor}" />
    <SolidColorBrush x:Key="ComboBoxHeaderForeground"
                     Color="{ThemeResource EasydictControlPrimaryTextColor}" />
    <SolidColorBrush x:Key="ComboBoxHeaderForegroundDisabled"
                     Color="{ThemeResource EasydictControlTertiaryTextColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked"
                     Color="{ThemeResource EasydictControlOnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver"
                     Color="{ThemeResource EasydictControlOnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed"
                     Color="{ThemeResource EasydictControlOnAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"
                     Color="{ThemeResource EasydictControlAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"
                     Color="{ThemeResource EasydictControlOnAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver"
                     Color="{ThemeResource EasydictControlOnAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"
                     Color="{ThemeResource EasydictControlOnAccentColor}" />

    <Style x:Key="SettingsAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource EasydictAccentButtonStyle}">
        <Setter Property="MinHeight" Value="{ThemeResource EasydictStandardControlHeight}" />
    </Style>

    <Style x:Key="SettingsSectionStyle" TargetType="Border" BasedOn="{StaticResource EasydictSurfaceStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SettingsInlineIconButtonStyle" TargetType="Button" BasedOn="{StaticResource EasydictIconButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="SettingsLinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SettingsLinkForegroundBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SettingsTabButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="76" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="{ThemeResource EasydictControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EasydictPrimaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EasydictPrimaryTextBrush}" />
    </Style>
    <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EasydictPrimaryTextBrush}" />
    </Style>
    <Style x:Key="SettingsBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EasydictPrimaryTextBrush}" />
    </Style>
    <Style x:Key="SettingsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EasydictSecondaryTextBrush}" />
    </Style>
    <Style x:Key="SettingsFieldStyle" TargetType="Control">
        <Setter Property="MinHeight" Value="{ThemeResource EasydictStandardControlHeight}" />
    </Style>
</ResourceDictionary>
