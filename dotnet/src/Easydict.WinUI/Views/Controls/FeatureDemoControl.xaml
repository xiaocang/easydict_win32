<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Easydict.WinUI.Views.Controls.FeatureDemoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Easydict.WinUI.Views.Controls"
    MinHeight="330">
    <UserControl.Resources>
        <Storyboard x:Key="DemoStepTransition" Storyboard.TargetName="DemoStage" Storyboard.TargetProperty="Opacity">
            <DoubleAnimation From="0.76" To="1.0" Duration="0:0:0.18" />
        </Storyboard>
    </UserControl.Resources>
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid x:Name="RootGrid" RowSpacing="12" IsTabStop="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ProgressBar x:Name="StepProgress" AutomationProperties.AutomationId="FeatureDemoStepProgress"
                             AutomationProperties.Name="Demo progress" Minimum="0" Maximum="4" Value="0" VerticalAlignment="Center" />
                <TextBlock x:Name="StepCounterText" Grid.Column="1" AutomationProperties.AutomationId="FeatureDemoStepCounter"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="DemoStage" Grid.Row="1" MinHeight="230" RowSpacing="12" AutomationProperties.AutomationId="FeatureDemoStage">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="OfflineNoticeText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Row="1">
                    <Grid x:Name="SelectionDemoPanel">
                        <TextBox x:Name="SelectionSampleText" AutomationProperties.AutomationId="FeatureDemoSelectionSample"
                                 IsReadOnly="True" TextWrapping="Wrap" FontSize="22" Padding="18"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="ScreenshotDemoPanel" Visibility="Collapsed">
                        <Border x:Name="ScreenshotSampleBorder" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <TextBlock x:Name="ScreenshotSampleText" AutomationProperties.AutomationId="FeatureDemoScreenshotSourceText"
                                       FontSize="22" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
                <TextBlock x:Name="StageHintText" Grid.Row="2" AutomationProperties.AutomationId="FeatureDemoStageHint"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <controls:WrapPanel Grid.Row="2" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="8">
                <Button x:Name="PlayPauseButton" AutomationProperties.AutomationId="FeatureDemoPlayPause" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="12" /><TextBlock x:Name="PlayPauseText" />
                    </StackPanel>
                </Button>
                <Button x:Name="NextStepButton" AutomationProperties.AutomationId="FeatureDemoNextStep" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="NextStepText" /><FontIcon Glyph="&#xE72A;" FontSize="12" /></StackPanel>
                </Button>
                <Button x:Name="ReplayButton" AutomationProperties.AutomationId="FeatureDemoReplay" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock x:Name="ReplayText" /></StackPanel>
                </Button>
                <Button x:Name="StopButton" AutomationProperties.AutomationId="FeatureDemoStop" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71A;" FontSize="12" /><TextBlock x:Name="StopText" /></StackPanel>
                </Button>
            </controls:WrapPanel>
        </Grid>
    </Border>
</UserControl>
