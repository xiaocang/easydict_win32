<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Easydict.WinUI.Views.Controls.MinimalServiceResultItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Easydict.WinUI.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        x:Name="RootBorder"
        Background="{ThemeResource ResultViewBackgroundBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="{ThemeResource EasydictCardBorderThickness}"
        CornerRadius="{ThemeResource EasydictCardCornerRadius}"
        Margin="0,0,0,2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

            <Border
                x:Name="HeaderBar"
                Grid.Row="0"
                Background="{ThemeResource ServiceResultHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                PointerPressed="OnHeaderPointerPressed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="ServiceNameText"
                        Grid.Column="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ServiceResultHeaderForegroundBrush}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="1"
                        FontSize="10"
                        Foreground="{ThemeResource ServiceResultHeaderSecondaryForegroundBrush}"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"/>

                    <Button x:Name="CopyButton" Grid.Column="2" Width="32" Height="32" Padding="0"
                            Visibility="Collapsed" Click="OnCopyClicked">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                    </Button>
                    <Button x:Name="CollapseButton" Grid.Column="3" Width="32" Height="32" Padding="0"
                            Visibility="Collapsed" Click="OnCollapseClicked">
                        <FontIcon x:Name="CollapseIcon" Glyph="&#xE70D;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <Border
                x:Name="ContentArea"
                Grid.Row="1"
                Padding="8,6,8,8"
                Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="PendingQueryText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="Collapsed"/>

                    <TextBlock
                        x:Name="ResultText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource QueryTextBrush}"
                        FontSize="13"
                        Visibility="Collapsed"/>

                    <TextBlock
                        x:Name="ErrorText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        FontSize="12"
                        Visibility="Collapsed"/>
                    <StackPanel x:Name="SavedActionBar" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">
                        <Button x:Name="PlayButton" Width="32" Height="32" Padding="0" Click="OnPlayClicked">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14"/>
                        </Button>
                    <Button
                        x:Name="FavoriteButton"

                        Width="32"
                        Height="32"
                        Margin="6,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        Click="OnFavoriteClicked"
                        Visibility="Collapsed">
                        <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="12"/>
                    </Button>
                        <Button x:Name="SavedMoreButton" Width="32" Height="32" Padding="0">
                            <Button.Flyout><MenuFlyout>
                                <MenuFlyoutItem x:Name="SavedCopySourceMenuItem" Click="OnCopySavedSource"/>
                                <MenuFlyoutItem x:Name="SavedCollapseMenuItem" Click="OnCollapseClicked"/>
                            </MenuFlyout></Button.Flyout>
                            <FontIcon Glyph="&#xE712;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <controls:ResultMessageView x:Name="ResultFeedback" Grid.Row="2" IsOpen="False"/>
        </Grid>
    </Border>
</UserControl>
