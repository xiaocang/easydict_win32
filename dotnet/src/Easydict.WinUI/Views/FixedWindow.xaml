<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easydict.WinUI.Views.FixedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Easydict.WinUI.Views.Controls"
    mc:Ignorable="d"
    Title="Easydict ᵇᵉᵗᵃ Fixed">

    <Grid Background="Transparent"
          Padding="0">
        <Border
            x:Name="WindowSurface"
            Background="{ThemeResource EasydictLayerFillBrush}"
            BorderBrush="{ThemeResource EasydictCardBorderBrush}"
            BorderThickness="{ThemeResource EasydictCardBorderThickness}"
            CornerRadius="{ThemeResource EasydictCardCornerRadius}"
            Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Pin, OCR and Hide buttons - also serves as drag region -->
                <Grid x:Name="TitleBarRegion"
                Grid.Row="0"
                Margin="0,0,0,4"
                Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="PinButton"
                Grid.Column="0"
                Click="OnPinClicked"
                ToolTipService.ToolTip="Pin window (stay on top)"
                AutomationProperties.Name="Pin window (stay on top)"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{ThemeResource EasydictControlCornerRadius}"
                Width="28"
                Height="28"
                Padding="0">
                <FontIcon x:Name="PinIcon"
                        Glyph="&#xE718;"
                        FontSize="14"
                        Foreground="{ThemeResource EasydictIconForegroundBrush}"/>
            </ToggleButton>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Text="Fixed Translate"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource EasydictSecondaryTextBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>

            <Button
                x:Name="OcrButton"
                Grid.Column="2"
                Click="OnOcrClicked"
                Style="{StaticResource EasydictIconButtonStyle}"
                ToolTipService.ToolTip="OCR translate"
                AutomationProperties.Name="OCR translate"
                Width="28"
                Height="28"
                Padding="0">
                <FontIcon Glyph="&#xE722;"
                        FontSize="14"
                        Foreground="{ThemeResource EasydictIconForegroundBrush}"/>
            </Button>

            <Button
                x:Name="CloseButton"
                AutomationProperties.Name="Hide window"
                Grid.Column="3"
                Click="OnCloseClicked"
                Style="{StaticResource EasydictIconButtonStyle}"
                ToolTipService.ToolTip="Hide (Ctrl+Alt+F to show again)"
                Width="28"
                Height="28"
                Padding="0">
                <FontIcon Glyph="&#xE8BB;"
                        FontSize="14"
                        Foreground="{ThemeResource EasydictIconForegroundBrush}"/>
            </Button>
        </Grid>

        <!-- Compact Input -->
        <Border x:Name="SourceTextContainer"
                Grid.Row="1"
                Background="{ThemeResource EasydictInputBackgroundBrush}"
                BorderBrush="{ThemeResource EasydictInputBorderBrush}"
                BorderThickness="{ThemeResource EasydictCardBorderThickness}"
                CornerRadius="{ThemeResource EasydictControlCornerRadius}"
                Padding="8,4"
                Margin="0,0,0,4">
            <TextBox
                x:Name="InputTextBox"
                PlaceholderText="Enter text..."
                Style="{StaticResource CompactTranslationTextBoxStyle}"
                PreviewKeyDown="OnInputKeyDown"/>
        </Border>

        <!-- Language Bar -->
        <Grid Grid.Row="2"
                Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="SourceLangCombo"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnSourceLangChanged"
                ToolTipService.ToolTip="Source Language">
                <!-- Populated dynamically in code-behind -->
            </ComboBox>

            <Button
                x:Name="SwapButton"
                Grid.Column="1"
                Click="OnSwapClicked"
                Width="28"
                Height="28"
                Padding="0"
                Style="{StaticResource EasydictIconButtonStyle}"
                ToolTipService.ToolTip="Swap languages"
                AutomationProperties.Name="Swap languages"
                Margin="4,0">
                <FontIcon Glyph="&#xE8AB;"
                        FontSize="12"
                        Foreground="{ThemeResource EasydictIconForegroundBrush}"/>
            </Button>

            <ComboBox
                x:Name="TargetLangCombo"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnTargetLangChanged"
                ToolTipService.ToolTip="Target Language">
                <!-- Populated dynamically in code-behind -->
            </ComboBox>

            <Button
                x:Name="TranslateButton"
                Grid.Column="3"
                Click="OnTranslateClicked"
                Width="32"
                Height="32"
                Padding="0"
                Style="{StaticResource EasydictPrimaryIconButtonStyle}"
                ToolTipService.ToolTip="Translate"
                AutomationProperties.Name="Translate"
                Margin="4,0,0,0">
                <Grid>
                    <ProgressRing
                        x:Name="LoadingRing"
                        IsActive="False"
                        Width="14"
                        Height="14"
                        Foreground="{ThemeResource EasydictAccentForegroundBrush}"
                        Visibility="Collapsed"/>
                    <FontIcon
                        x:Name="TranslateIcon"
                        Glyph="&#xE8C1;"
                        FontSize="14"
                        Foreground="{ThemeResource EasydictAccentForegroundBrush}"/>
                </Grid>
            </Button>
        </Grid>

        <!-- Detected Language Label -->
        <TextBlock
            x:Name="DetectedLangText"
            Grid.Row="3"
            Text=""
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource EasydictLinkBrush}"
            Margin="0,0,0,2"
            Visibility="Collapsed"/>

        <!-- Multi-Service Results -->
        <ScrollViewer
            x:Name="ResultsScrollViewer"
            Grid.Row="4"
            VerticalScrollBarVisibility="Visible"
            ViewChanged="OnResultsScrollViewerViewChanged">
            <ItemsControl x:Name="ResultsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="5"
            Text=""
            FontSize="10"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            HorizontalAlignment="Right"
            Margin="0,4,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
