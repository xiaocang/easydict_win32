<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easydict.WinUI.Views.HoverLookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="">

    <Grid x:Name="RootGrid"
          AutomationProperties.AutomationId="HoverLookupPopup"
          Background="{ThemeResource PopButtonBackgroundBrush}"
          CornerRadius="{ThemeResource EasydictCardCornerRadius}"
          BorderBrush="{ThemeResource PopButtonBorderBrush}"
          BorderThickness="1"
          Padding="12,8,12,10"
          MaxWidth="320">
        <Grid x:Name="ContentViewport" SizeChanged="OnContentViewportSizeChanged">
            <StackPanel x:Name="ContentPanel" Spacing="4" VerticalAlignment="Top">
                <!-- Header: word + "open in Mini window" -->
                <Grid x:Name="HeaderGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WordText"
                               Grid.Column="0"
                               AutomationProperties.AutomationId="HoverLookupWord"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Button x:Name="OpenInMiniButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="HoverLookupOpenInMiniButton"
                            Width="26"
                            Height="26"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            Click="OnOpenInMiniButtonClick">
                        <FontIcon Glyph="&#xE8A7;"
                                  FontSize="12"
                                  Foreground="{ThemeResource PopButtonForegroundBrush}"/>
                    </Button>
                </Grid>

                <!-- Phonetics -->
                <TextBlock x:Name="PhoneticText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"/>

                <!-- Loading -->
                <StackPanel x:Name="LoadingPanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True"
                                  Width="14"
                                  Height="14"
                                  MinWidth="14"
                                  MinHeight="14"/>
                    <TextBlock x:Name="LoadingText"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Result body -->
                <TextBlock x:Name="BodyText"
                           AutomationProperties.AutomationId="HoverLookupBody"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="Collapsed"/>

                <!-- Service name -->
                <TextBlock x:Name="ServiceText"
                           AutomationProperties.AutomationId="HoverLookupService"
                           FontSize="10"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
