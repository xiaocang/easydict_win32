<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <!-- Execute the production lifecycle/policy source and the same tests as the
       Windows suite without loading WinUI or a native UIA provider. -->
  <ItemGroup>
    <Compile Include="..\..\src\Easydict.WinUI\Services\SelectionCaptureSession.cs" Link="Services\SelectionCaptureSession.cs" />
    <Compile Include="..\..\src\Easydict.WinUI\Services\UiaSelectionResult.cs" Link="Services\UiaSelectionResult.cs" />
    <Compile Include="..\..\src\Easydict.WinUI\Services\HotkeyWindowShowCoordinator.cs" Link="Services\HotkeyWindowShowCoordinator.cs" />
    <Compile Include="..\Easydict.WinUI.Tests\Services\SelectionCaptureSessionTests.cs" Link="Tests\SelectionCaptureSessionTests.cs" />
    <Compile Include="..\Easydict.WinUI.Tests\Services\SelectionCaptureFallbackTests.cs" Link="Tests\SelectionCaptureFallbackTests.cs" />
    <Compile Include="..\Easydict.WinUI.Tests\Services\HotkeyWindowShowCoordinatorTests.cs" Link="Tests\HotkeyWindowShowCoordinatorTests.cs" />
  </ItemGroup>

</Project>
